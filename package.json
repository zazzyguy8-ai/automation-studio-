{
  "name": "automation-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Internal AI Automation Agency OS: business audit -> automation proposal -> personalized demo -> outreach -> client agent blueprint.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx --env-file-if-exists=.env.local scripts/db-push.ts",
    "pipeline": "tsx --env-file-if-exists=.env.local scripts/pipeline.ts",
    "test:e2e": "tsx --env-file-if-exists=.env.local scripts/run-e2e.ts",
    "seed": "tsx --env-file-if-exists=.env.local scripts/seed-demo.ts",
    "test:anthropic": "tsx --env-file-if-exists=.env.local scripts/test-anthropic-wiring.ts",
    "test:pipeline": "tsx --env-file-if-exists=.env.local scripts/test-pipeline.ts",
    "test": "npm run typecheck && npm run test:pipeline && npm run test:discovery && npm run test:anthropic && npm run test:e2e",
    "discover": "tsx --env-file-if-exists=.env.local scripts/discover.ts",
    "test:discovery": "tsx --env-file-if-exists=.env.local scripts/test-discovery.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "next": "15.5.4",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
