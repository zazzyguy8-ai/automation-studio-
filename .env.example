# ---- Reasoning ----
ANTHROPIC_API_KEY=
AUDIT_MODEL=claude-opus-5
COPY_MODEL=claude-sonnet-5

# ---- Storage ----
# Leave empty to run on the file-backed dev store (.data/), no Postgres needed.
DATABASE_URL=

# ---- Fetching ----
CRAWL_USER_AGENT=AutomationStudioBot/0.1 (+audit)
CRAWL_MAX_PAGES=8
CRAWL_TIMEOUT_MS=12000

# ---- Delivery-side providers (referenced by blueprints, never stored in the DB) ----
# These are the env var NAMES a client agent will need. Values live only here / in n8n credentials.
# TELNYX_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=
