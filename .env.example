# ---- Reasoning ----
ANTHROPIC_API_KEY=
# Both are optional - leave them empty to use the defaults shown.
# Supported: claude-opus-5, claude-sonnet-5, claude-haiku-4-5.
# No date suffixes: claude-opus-5, never claude-opus-5-20260401.
# An unsupported or truncated value is refused at startup rather than sent to
# the API, where it would come back as an unhelpful 404.
AUDIT_MODEL=claude-opus-5
COPY_MODEL=claude-sonnet-5

# ---- Storage ----
# Leave empty to run on the file-backed dev store (.data/), no Postgres needed.
DATABASE_URL=

# ---- Fetching ----
CRAWL_USER_AGENT=AutomationStudioBot/0.1 (+audit)
CRAWL_MAX_PAGES=8
CRAWL_TIMEOUT_MS=12000

# ---- Delivery-side providers (referenced by blueprints, never stored in the DB) ----
# These are the env var NAMES a client agent will need. Values live only here / in n8n credentials.
# TELNYX_API_KEY=
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# STRIPE_SECRET_KEY=

# ---- Outbound email (the outreach engine) ----
# Sending stays a DRY RUN unless BOTH of the next two are set.
# One switch is a config mistake; two is a decision.
RESEND_API_KEY=
OUTREACH_SENDING_ENABLED=false

# Required before any email can be APPROVED, let alone sent. Without them the
# opt-out names no address, which every market in src/lib/discovery/markets.ts
# requires. Use a sending subdomain you are willing to lose, never your primary
# domain, and never a noreply@ address - cold outreach needs replies to reach you.
SENDER_EMAIL=richard@mail.yourdomain.com
SENDER_NAME=Richard
SENDER_COMPANY=Automation Studio
SENDER_CALENDAR_URL=https://cal.com/your-handle/15min

# Defaults to SENDER_EMAIL when empty.
UNSUBSCRIBE_ADDRESS=
# Required by US CAN-SPAM; optional for the UK-only experiment 01.
SENDER_POSTAL_ADDRESS=
