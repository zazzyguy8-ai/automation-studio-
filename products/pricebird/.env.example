# Pricebird configuration. Copy to .env.local — that file is gitignored and is
# the only place a key belongs. Never paste one into a commit or a chat.

# --- required to write listings -------------------------------------------
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5, which sees as well as Opus on a
# photograph and costs a fraction. Supported: claude-opus-5, claude-sonnet-5,
# claude-haiku-4-5. A value that is not on that list is refused at startup
# rather than 404-ing mid-upload.
VISION_MODEL=

# --- required in production ------------------------------------------------
# Signs session cookies. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Where the app is reachable. Stripe returns the customer here after checkout.
APP_URL=http://localhost:3000
# In production: APP_URL=https://pricebird.org

# Postgres. Without it, everything is written to .data/pricebird.json, which is
# fine on a laptop and is not a production database.
DATABASE_URL=

# --- billing ---------------------------------------------------------------
STRIPE_SECRET_KEY=
# From `stripe listen --forward-to localhost:3000/api/billing/webhook`, or from
# the dashboard endpoint. Without it no payment ever upgrades an account.
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# --- sign-in email ---------------------------------------------------------
# Without these, sign-in codes are printed to the server log in development
# and refused outright in production.
RESEND_API_KEY=
MAIL_FROM="Pricebird <hello@yourdomain.com>"
