{
  "name": "pricebird",
  "version": "0.1.0",
  "private": true,
  "description": "Photo in, listing out. Turns a phone photo of an item into a marketplace listing: title, description, price range and keywords, per platform.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "db:push": "tsx --env-file-if-exists=.env.local scripts/db-push.ts",
    "listing": "tsx --env-file-if-exists=.env.local scripts/listing.ts",
    "test:listing": "tsx --env-file-if-exists=.env.local scripts/test-listing.ts",
    "test:quota": "tsx --env-file-if-exists=.env.local scripts/test-quota.ts",
    "test": "npm run typecheck && npm run test:listing && npm run test:quota",
    "doctor": "tsx --env-file-if-exists=.env.local scripts/doctor.ts",
    "setup:stripe": "tsx --env-file-if-exists=.env.local scripts/setup-stripe.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.65.0",
    "next": "15.5.4",
    "pg": "^8.13.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "stripe": "^22.6.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
